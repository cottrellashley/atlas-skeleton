{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jhg.com/protocol/1.0/event.schema.json",
  "title": "Event",
  "description": "A CloudEvent 1.0.2 in its JSON format (§2.5), received over AMQP after a connect handover. `dataschema` names the writer profile; a subscriber resolves `data` from it (§9.5) and drops one whose `id` it has seen in its last 10,000.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "dataschema",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique per event: the duplicate key."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "A URI-reference: the publisher (a client's name when it publishes, §9.7.8)."
    },
    "type": {
      "type": "string",
      "pattern": "^com\\.jhg\\.fiquant\\.[a-z](-?[a-z0-9])*(\\.[a-z](-?[a-z0-9])*)+\\.v[1-9][0-9]*$",
      "description": "com.jhg.fiquant.<id>.v<N>."
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "pattern": "^urn:atlas:profile:[a-z](-?[a-z0-9])*(\\.[a-z](-?[a-z0-9])*)+@v[1-9][0-9]*:[0-9a-f]{16}$",
      "description": "urn:atlas:profile:<id>@vN:<fingerprint> (§9.4.3)."
    },
    "data": {
      "type": "object",
      "description": "The payload, a record in the profile's payload schema."
    }
  }
}
