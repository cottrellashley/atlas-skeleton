{
  "id": "CORE-SIGNIN-003",
  "level": "Core",
  "description": "A 401 with error=\"invalid_token\" makes the client refresh and repeat once; a second 401 is unauthenticated.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      }
    ]
  },
  "gateway": {
    "tokens": {
      "access": [
        "ct-valid",
        "ct-refreshed"
      ],
      "refresh": {
        "rt-valid": {
          "access_token": "ct-refreshed",
          "refresh_token": "rt-2",
          "expires_in": 3600
        },
        "rt-2": {
          "access_token": "ct-refreshed",
          "refresh_token": "rt-3",
          "expires_in": 3600
        }
      }
    },
    "steps": [
      {
        "match": {
          "address": "atlas.whoami:fetch",
          "nth": 1
        },
        "respond": {
          "status": 401,
          "problem": {
            "code": "unauthenticated",
            "retryable": false
          },
          "headers": {
            "WWW-Authenticate": "Bearer realm=\"atlas\", error=\"invalid_token\""
          }
        },
        "times": 1
      },
      {
        "match": {
          "address": "atlas.whoami:fetch",
          "nth": 3
        },
        "respond": {
          "status": 401,
          "problem": {
            "code": "unauthenticated",
            "retryable": false
          },
          "headers": {
            "WWW-Authenticate": "Bearer realm=\"atlas\", error=\"invalid_token\""
          }
        },
        "times": 2
      }
    ]
  },
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "whoami",
      "args": {}
    },
    {
      "id": 3,
      "op": "whoami",
      "args": {}
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true
    },
    {
      "id": 3,
      "ok": false,
      "problem": {
        "code": "unauthenticated"
      }
    }
  ],
  "expected_requests": [
    {
      "assert": "count",
      "select": {
        "address": "atlas.whoami:fetch"
      },
      "equals": 4
    },
    {
      "assert": "count",
      "select": {
        "path": "/oauth/token"
      },
      "equals": 2
    },
    {
      "assert": "header",
      "select": {
        "address": "atlas.whoami:fetch",
        "nth": 2
      },
      "name": "Authorization",
      "equals": "Bearer ct-refreshed"
    }
  ],
  "note": "whoami 1 is refused, the token refreshed, whoami 2 succeeds; whoami 3 and its one repeat (4) are both refused: unauthenticated, after exactly one repeat."
}
