{
  "id": "CORE-LOCK-001",
  "level": "Core",
  "description": "atlas.lock is found in the nearest ancestor of the working directory; its entries are the reader profiles, fetched by exact, with no discovery call for them.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      },
      {
        "path": "{WORKDIR}/app/atlas.lock",
        "mode": "0644",
        "text": "[capabilities]\n\"conformance.evolving\" = { version = 1, fingerprint = \"bc7fde7c0bac077d\" }\n\"conformance.echo\" = { version = 1, fingerprint = \"f17339273f0617c2\" }\n"
      },
      {
        "path": "{WORKDIR}/app/src/deep/.keep",
        "text": ""
      }
    ],
    "cwd": "{WORKDIR}/app/src/deep"
  },
  "gateway": {},
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "call",
      "args": {
        "address": "conformance.echo@v1:fetch",
        "request": {
          "text": "hello"
        }
      }
    },
    {
      "id": 3,
      "op": "call",
      "args": {
        "address": "conformance.evolving@v1:fetch",
        "request": {
          "ids": [
            "p1"
          ]
        },
        "options": {
          "accept": [
            "application/json"
          ]
        }
      }
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true,
      "value": {
        "text": "hello",
        "count": 1,
        "ratio": null,
        "when": null,
        "kind": "plain",
        "tags": []
      }
    },
    {
      "id": 3,
      "ok": true
    }
  ],
  "expected_requests": [
    {
      "assert": "count",
      "select": {
        "address": "atlas.catalog:fetch"
      },
      "equals": 0
    },
    {
      "assert": "count",
      "select": {
        "address": "atlas.search:fetch"
      },
      "equals": 0
    },
    {
      "assert": "count",
      "select": {
        "address": "atlas.describe:fetch",
        "body_contains": {
          "by": "id"
        }
      },
      "equals": 0
    },
    {
      "assert": "header",
      "select": {
        "address": "conformance.evolving@v1:fetch"
      },
      "name": "Atlas-Profile-Expect",
      "equals": "conformance.evolving@v1#bc7fde7c0bac077d"
    },
    {
      "assert": "header",
      "select": {
        "address": "conformance.echo@v1:fetch"
      },
      "name": "Atlas-Profile-Expect",
      "equals": "conformance.echo@v1#f17339273f0617c2"
    }
  ]
}
