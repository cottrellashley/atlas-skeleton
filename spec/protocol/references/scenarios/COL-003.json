{
  "id": "COL-003",
  "level": "Columnar",
  "description": "An Arrow answer under a newer fingerprint: column-wise resolution equals row-wise.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      },
      {
        "path": "{WORKDIR}/atlas.lock",
        "mode": "0644",
        "text": "[capabilities]\n\"conformance.evolving\" = { version = 1, fingerprint = \"bc7fde7c0bac077d\" }\n"
      }
    ],
    "cwd": "{WORKDIR}"
  },
  "gateway": {
    "steps": [
      {
        "match": {
          "address": "conformance.evolving@v1:fetch"
        },
        "respond": {
          "status": 200,
          "profile": "conformance.evolving@v1#73def445ee90c57a",
          "stream": {
            "encoding": "arrow",
            "rows": [
              {
                "id": "p1",
                "market_value": 1250.5,
                "weight": 0.015,
                "currency": "EUR",
                "status": "closed",
                "count": 3.0,
                "note": null
              },
              {
                "id": "p2",
                "market_value": 1250.5,
                "weight": 0.015,
                "currency": "EUR",
                "status": "open",
                "count": 3.0,
                "note": null
              }
            ],
            "end": "default"
          }
        },
        "times": 1
      }
    ]
  },
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "call",
      "args": {
        "address": "conformance.evolving@v1:fetch",
        "request": {
          "ids": [
            "p1",
            "p2"
          ]
        },
        "options": {
          "accept": [
            "application/vnd.apache.arrow.stream"
          ]
        }
      }
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true,
      "value": [
        {
          "id": "p1",
          "mv": 1250.5,
          "weight": 1.5,
          "status": "sold",
          "count": 3
        },
        {
          "id": "p2",
          "mv": 1250.5,
          "weight": 1.5,
          "status": "open",
          "count": 3
        }
      ]
    }
  ],
  "expected_requests": []
}
