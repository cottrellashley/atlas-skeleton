{
  "id": "CORE-CALL-003",
  "level": "Core",
  "description": "The client follows the binding the profile serves, here at an unusual address; it never builds a path.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      }
    ]
  },
  "gateway": {
    "current": {
      "conformance.echo@v1": "conformance.echo@v1#d0a02ef751a8d8e7"
    }
  },
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "call",
      "args": {
        "address": "conformance.echo@v1:fetch",
        "request": {
          "text": "hello"
        }
      }
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true,
      "value": {
        "text": "hello",
        "count": 1,
        "ratio": null,
        "when": null,
        "kind": "plain",
        "tags": []
      }
    }
  ],
  "expected_requests": [
    {
      "assert": "count",
      "select": {
        "path": "/elsewhere/7/echo;v=1",
        "method": "POST"
      },
      "equals": 1
    },
    {
      "assert": "count",
      "select": {
        "path": "/v1/data/conformance.echo@v1:fetch"
      },
      "equals": 0
    }
  ]
}
