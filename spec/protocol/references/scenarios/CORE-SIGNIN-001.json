{
  "id": "CORE-SIGNIN-001",
  "level": "Core",
  "description": "The token comes from <ATLAS_HOME>/state/token-<env>.json, <env> being the bootstrap's environment.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-from-file",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      }
    ]
  },
  "gateway": {
    "tokens": {
      "access": [
        "ct-from-file"
      ],
      "refresh": {}
    }
  },
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "whoami",
      "args": {}
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true
    }
  ],
  "expected_requests": [
    {
      "assert": "header",
      "select": {
        "path": "/.well-known/atlas",
        "method": "GET"
      },
      "name": "Authorization",
      "absent": true
    },
    {
      "assert": "header",
      "select": {
        "address": "atlas.whoami:fetch"
      },
      "name": "Authorization",
      "equals": "Bearer ct-from-file"
    }
  ],
  "questions": [
    "Q-CLI-1"
  ]
}
