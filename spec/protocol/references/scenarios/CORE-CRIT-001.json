{
  "id": "CORE-CRIT-001",
  "level": "Core",
  "description": "A trait marked critical that the client does not implement: critical_trait_unsupported, and no call is made.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      }
    ]
  },
  "gateway": {},
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "call",
      "args": {
        "address": "conformance.critical@v1:fetch",
        "request": {
          "text": "x"
        }
      }
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": false,
      "problem": {
        "code": "critical_trait_unsupported"
      }
    }
  ],
  "expected_requests": [
    {
      "assert": "count",
      "select": {
        "address": "conformance.critical@v1:fetch"
      },
      "equals": 0
    }
  ]
}
