{
  "id": "CORE-RES-001",
  "level": "Core",
  "description": "An answer under a newer fingerprint: the client fetches the writer's profile (and the chain's) by exact, applies each lens backward, and returns its own shape.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      },
      {
        "path": "{WORKDIR}/atlas.lock",
        "mode": "0644",
        "text": "[capabilities]\n\"conformance.evolving\" = { version = 1, fingerprint = \"bc7fde7c0bac077d\" }\n"
      }
    ],
    "cwd": "{WORKDIR}"
  },
  "gateway": {
    "steps": [
      {
        "match": {
          "address": "conformance.evolving@v1:fetch"
        },
        "respond": {
          "status": 200,
          "profile": "conformance.evolving@v1#73def445ee90c57a",
          "body": [
            {
              "id": "p1",
              "market_value": 1250.5,
              "weight": 0.015,
              "currency": "EUR",
              "status": "closed",
              "count": 3.0,
              "note": null
            }
          ]
        },
        "times": 1
      }
    ]
  },
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "call",
      "args": {
        "address": "conformance.evolving@v1:fetch",
        "request": {
          "ids": [
            "p1"
          ]
        },
        "options": {
          "accept": [
            "application/json"
          ]
        }
      }
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true,
      "value": [
        {
          "id": "p1",
          "mv": 1250.5,
          "weight": 1.5,
          "status": "sold",
          "count": 3
        }
      ]
    }
  ],
  "expected_requests": [
    {
      "assert": "header",
      "select": {
        "address": "conformance.evolving@v1:fetch"
      },
      "name": "Atlas-Profile-Expect",
      "equals": "conformance.evolving@v1#bc7fde7c0bac077d"
    },
    {
      "assert": "describe_exact",
      "exact": "conformance.evolving@v1#73def445ee90c57a",
      "count": 1
    },
    {
      "assert": "describe_exact",
      "exact": "conformance.evolving@v1#5f4ce7e7661ebd4c",
      "count": 1
    }
  ],
  "note": "The same record as resolution.json's case 'through two lenses backward'."
}
