                }
              ]
            }
          }
        },
        "atlas.catalog.changed": {
          "version": 1,
          "interactions": {
            "subscribe": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.catalog.changed:subscribe",
                  "encodings": [
