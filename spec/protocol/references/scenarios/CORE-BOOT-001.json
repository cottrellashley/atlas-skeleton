{
  "id": "CORE-BOOT-001",
  "level": "Core",
  "description": "The bootstrap is fetched without a token and revalidated with If-None-Match; every URI is built from it (here atlas.whoami at an address the bootstrap moved).",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0600",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      }
    ]
  },
  "gateway": {
    "bootstrap": {
      "protocols": [
        "atlas/1.0"
      ],
      "minimum_protocol": "atlas/1.0",
      "environment": "conformance",
      "servers": {
        "gateway": {
          "url": "{gateway}",
          "description": "The conformance gateway."
        }
      },
      "builtins": {
        "atlas.whoami": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/bootstrapped/who-am-i",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.catalog": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.catalog:fetch",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.search": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.search:fetch",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.describe": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.describe:fetch",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.guide": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.guide:fetch",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.access": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.access:fetch",
                  "encodings": [
                    "json"
                  ],
