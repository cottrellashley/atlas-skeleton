                }
              ]
            }
          }
        },
        "atlas.usage": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.usage:fetch",
