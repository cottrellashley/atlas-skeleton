                }
              ]
            }
          }
        },
        "atlas.settings": {
          "version": 1,
          "interactions": {
            "get": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.settings:get",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            },
            "update": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.settings:update",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.directory": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.directory:fetch",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        },
        "atlas.audit": {
          "version": 1,
          "interactions": {
            "fetch": {
              "bindings": [
                {
                  "protocol": "https",
                  "server": "gateway",
                  "method": "POST",
                  "address": "/v1/atlas/atlas.audit:fetch",
                  "encodings": [
                    "json"
                  ],
                  "auth": "bearer"
                }
              ]
            }
          }
        }
      },
      "sign_in": {
        "authority": "{gateway}/oauth",
        "client_id": "atlas-conformance",
        "scopes": [
          "{gateway}/.default"
        ],
        "token_endpoint": "{gateway}/oauth/token",
        "authorization_endpoint": "{gateway}/oauth/authorize",
        "device_authorization_endpoint": "{gateway}/oauth/device"
      },
      "catalog_etag": "\"catalog-1\""
    },
    "headers": {
      "/.well-known/atlas": {
        "ETag": "\"boot-1\""
      }
    }
  },
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "whoami",
      "args": {}
    },
    {
      "id": 3,
      "op": "connect",
      "args": {}
    },
    {
      "id": 4,
      "op": "whoami",
      "args": {}
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": true,
      "value_contains": {
        "environment": "conformance"
      }
    },
    {
      "id": 3,
      "ok": true
    },
    {
      "id": 4,
      "ok": true
    }
  ],
  "expected_requests": [
    {
      "assert": "header",
      "select": {
        "nth": 1,
        "path": "/.well-known/atlas"
      },
      "name": "Authorization",
      "absent": true
    },
    {
      "assert": "header",
      "select": {
        "nth": 2,
        "path": "/.well-known/atlas"
      },
      "name": "If-None-Match",
      "equals": "\"boot-1\""
    },
    {
      "assert": "count",
      "select": {
        "path": "/bootstrapped/who-am-i",
        "method": "POST"
      },
      "equals": 2
    },
    {
      "assert": "count",
      "select": {
        "path": "/v1/atlas/atlas.whoami:fetch"
      },
      "equals": 0
    }
  ],
  "note": "The gateway answers the second bootstrap 304 Not Modified to its If-None-Match."
}
