{
  "id": "CORE-SIGNIN-005",
  "level": "Core",
  "description": "A token file readable by others (mode 0644) is refused, and with no person the call is unauthenticated; the token is never sent.",
  "setup": {
    "env": {
      "ATLAS_URL": "{gateway}",
      "ATLAS_HOME": "{ATLAS_HOME}",
      "ATLAS_CONFORMANCE": "1"
    },
    "files": [
      {
        "path": "{ATLAS_HOME}/state/token-conformance.json",
        "mode": "0644",
        "dir_mode": "0700",
        "json": {
          "access_token": "ct-valid",
          "expires_at": {
            "$now_plus_s": 3600
          },
          "refresh_token": "rt-valid"
        }
      }
    ]
  },
  "gateway": {},
  "commands": [
    {
      "id": 1,
      "op": "connect",
      "args": {}
    },
    {
      "id": 2,
      "op": "whoami",
      "args": {}
    }
  ],
  "expected": [
    {
      "id": 1,
      "ok": true
    },
    {
      "id": 2,
      "ok": false,
      "problem": {
        "code": "unauthenticated"
      }
    }
  ],
  "expected_requests": [
    {
      "assert": "count",
      "select": {
        "header_equals": {
          "Authorization": "Bearer ct-valid"
        }
      },
      "equals": 0
    }
  ]
}
