{
  "description": "The read-only guard (§6.4.3): every statement is refused unless it is exactly one read-only query (SELECT, UNION, INTERSECT, EXCEPT, WITH) over the registered objects. `registered` lists identifiers as Snowflake resolves them (unquoted upper-cased, quoted exact): a [database, schema] pair registers every object in the schema, a triple one object. An implementation passes a case when it accepts or refuses it as `accepted` says; `reason` names the first rule that refuses it, in the order guard.py documents (dml, ddl, copy, file_transfer, call, not_a_query, select_into, stage, table_function, system_function, dynamic_identifier, unqualified_object, unregistered_object), and `objects` the objects an accepted statement reads. Generated with sqlglot 30.27.0's Snowflake parser.",
  "registered": [
    [
      "HARBOUR",
      "GOLD"
    ],
    [
      "HARBOUR",
      "SILVER",
      "PRICES"
    ]
  ],
  "cases": [
    {
      "name": "a select",
      "statement": "SELECT portfolio, weight FROM HARBOUR.GOLD.HOLDINGS",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      },
      "note": "an object in a registered schema"
    },
    {
      "name": "a registered object",
      "statement": "SELECT close FROM HARBOUR.SILVER.PRICES",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "SILVER",
            "PRICES"
          ]
        ]
      },
      "note": "registered by itself"
    },
    {
      "name": "unquoted names are upper-cased",
      "statement": "select * from harbour.gold.holdings",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      }
    },
    {
      "name": "a trailing semicolon",
      "statement": "SELECT 1 FROM HARBOUR.GOLD.HOLDINGS;",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      }
    },
    {
      "name": "a join and a subquery",
      "statement": "SELECT h.portfolio, p.close FROM HARBOUR.GOLD.HOLDINGS h JOIN HARBOUR.SILVER.PRICES p ON p.isin = h.isin WHERE h.weight > (SELECT AVG(weight) FROM HARBOUR.GOLD.HOLDINGS)",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ],
          [
            "HARBOUR",
            "SILVER",
            "PRICES"
          ]
        ]
      }
    },
    {
      "name": "WITH: a CTE name is not a table",
      "statement": "WITH top AS (SELECT * FROM HARBOUR.GOLD.HOLDINGS WHERE weight > 0.01) SELECT * FROM top",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      }
    },
    {
      "name": "a CTE that reads another CTE",
      "statement": "WITH a AS (SELECT * FROM HARBOUR.GOLD.HOLDINGS), b AS (SELECT * FROM a) SELECT * FROM b",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      }
    },
    {
      "name": "a recursive CTE",
      "statement": "WITH RECURSIVE r AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT * FROM r",
      "expected": {
        "accepted": true,
        "objects": []
      }
    },
    {
      "name": "UNION ALL",
      "statement": "SELECT isin FROM HARBOUR.GOLD.HOLDINGS UNION ALL SELECT isin FROM HARBOUR.SILVER.PRICES",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ],
          [
            "HARBOUR",
            "SILVER",
            "PRICES"
          ]
        ]
      }
    },
    {
      "name": "INTERSECT",
      "statement": "SELECT isin FROM HARBOUR.GOLD.HOLDINGS INTERSECT SELECT isin FROM HARBOUR.SILVER.PRICES",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ],
          [
            "HARBOUR",
            "SILVER",
            "PRICES"
          ]
        ]
      }
    },
    {
      "name": "EXCEPT",
      "statement": "(SELECT isin FROM HARBOUR.GOLD.HOLDINGS) EXCEPT (SELECT isin FROM HARBOUR.SILVER.PRICES)",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ],
          [
            "HARBOUR",
            "SILVER",
            "PRICES"
          ]
        ]
      }
    },
    {
      "name": "no table at all",
      "statement": "SELECT 1",
      "expected": {
        "accepted": true,
        "objects": []
      }
    },
    {
      "name": "VALUES",
      "statement": "SELECT * FROM (VALUES (1), (2)) AS v(a)",
      "expected": {
        "accepted": true,
        "objects": []
      }
    },
    {
      "name": "time travel reads only",
      "statement": "SELECT * FROM HARBOUR.GOLD.HOLDINGS AT(OFFSET => -60)",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      }
    },
    {
      "name": "a comment hides nothing",
      "statement": "SELECT 1 FROM HARBOUR.GOLD.HOLDINGS -- ; DROP TABLE x",
      "expected": {
        "accepted": true,
        "objects": [
          [
            "HARBOUR",
            "GOLD",
            "HOLDINGS"
          ]
        ]
      }
    },
    {
      "name": "unparsable",
      "statement": "SELEC 1",
      "expected": {
        "accepted": false,
        "reason": "parse_error"
      }
    },
    {
      "name": "empty",
      "statement": "   ",
      "expected": {
        "accepted": false,
        "reason": "empty"
      }
    },
    {
      "name": "two statements",
      "statement": "SELECT 1; SELECT 2",
      "expected": {
        "accepted": false,
        "reason": "multiple_statements"
      }
    },
    {
      "name": "an empty second statement",
      "statement": "SELECT 1;;",
      "expected": {
        "accepted": false,
        "reason": "multiple_statements"
      },
      "question": "Q-GUARD-2"
    },
    {
