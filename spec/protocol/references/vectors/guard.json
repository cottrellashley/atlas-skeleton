    },
    {
      "name": "WITH, then INSERT",
      "statement": "WITH x AS (SELECT 1) INSERT INTO HARBOUR.GOLD.HOLDINGS SELECT * FROM x",
      "expected": {
        "accepted": false,
        "reason": "dml"
      }
    },
    {
      "name": "CREATE TABLE AS SELECT",
      "statement": "CREATE TABLE HARBOUR.GOLD.COPY AS SELECT * FROM HARBOUR.GOLD.HOLDINGS",
