      }
    },
    {
      "name": "MERGE",
      "statement": "MERGE INTO HARBOUR.GOLD.HOLDINGS t USING HARBOUR.SILVER.PRICES s ON t.isin = s.isin WHEN MATCHED THEN DELETE",
