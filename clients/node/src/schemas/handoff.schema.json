{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jhg.com/protocol/1.0/handoff.schema.json",
  "title": "Handoff",
  "description": "`fetch` answered by a handoff (§2.2.1.3, §9.6.5): one result's chunks, to download directly from the source's result storage. application/vnd.atlas.handoff+json, Cache-Control: no-store. The client GETs each chunk `url` with its `headers`, in parallel, decodes it by `format` into the writer profile's Arrow schema (§9.2.7), checks each batch against it (invalid_document on a mismatch), and when links expire asks `operation` again for fresh ones.",
  "type": "object",
  "required": [
    "profile",
    "format",
    "source_schema",
    "first_chunk",
    "chunks",
    "expires",
    "operation"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "format": "exact-id",
      "description": "The writer profile."
    },
    "format": {
      "type": "string",
      "enum": [
        "snowflake-arrow/1",
        "UNKNOWN"
      ],
      "x-atlas-enum": [
        {
          "value": "snowflake-arrow/1"
        },
        {
          "value": "UNKNOWN",
          "description": "A value this reader does not know (§9.5.5)."
        }
      ],
      "description": "The chunks' format and its version; a client that does not declare it in Atlas-Client-Features is streamed instead."
    },
    "source_schema": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_column"
      },
      "description": "The source's result schema, in result column order."
    },
    "first_chunk": {
      "description": "The first chunk, inline, or null when it travels as the first of `chunks`.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/inline_chunk"
        }
      ]
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      },
      "description": "The chunks to download, in result order."
    },
    "rows": {
      "type": "integer",
      "minimum": 0,
      "x-atlas-unit": "count",
      "description": "Rows in the whole result."
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "description": "When the links stop working."
    },
    "operation": {
      "type": "string",
      "pattern": "^operations/[a-z0-9][a-z0-9-]*$",
      "description": "The operation to ask again (atlas.operation:get) for fresh links; its result is a handoff document (Q-DOC-12)."
    }
  },
  "$defs": {
    "source_column": {
      "type": "object",
      "required": [
        "name",
        "type",
        "nullable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The column's name as the result carries it (the contract name)."
        },
        "type": {
          "type": "string",
          "enum": [
            "FIXED",
            "REAL",
            "TEXT",
            "BOOLEAN",
            "DATE",
            "TIME",
            "TIMESTAMP_NTZ",
            "TIMESTAMP_LTZ",
            "TIMESTAMP_TZ",
            "BINARY",
            "VARIANT",
            "OBJECT",
            "ARRAY",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "FIXED"
            },
            {
              "value": "REAL"
            },
            {
              "value": "TEXT"
            },
            {
              "value": "BOOLEAN"
            },
            {
              "value": "DATE"
            },
            {
              "value": "TIME"
            },
            {
              "value": "TIMESTAMP_NTZ"
            },
            {
              "value": "TIMESTAMP_LTZ"
            },
            {
              "value": "TIMESTAMP_TZ"
            },
            {
              "value": "BINARY"
            },
            {
              "value": "VARIANT"
            },
            {
              "value": "OBJECT"
            },
            {
              "value": "ARRAY"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ],
          "description": "Snowflake's logical type (the chunk field's logicalType)."
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "inline_chunk": {
      "type": "object",
      "required": [
        "rows",
        "data"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count"
        },
        "data": {
          "type": "string",
          "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "description": "The chunk's bytes (an Arrow IPC stream), base64 (RFC 4648 section 4)."
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": [
        "url",
        "rows",
        "bytes",
        "headers"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "A pre-signed link to the chunk; the link is the credential."
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count",
          "description": "The chunk's size as downloaded."
        },
        "uncompressed_bytes": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count"
        },
        "headers": {
          "type": "object",
          "description": "Headers the download must send (on some clouds, the result's encryption key).",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
