{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jhg.com/protocol/1.0/builtins.schema.json",
  "title": "Built-ins",
  "description": "One $defs entry per built-in request and result of §9.3.2. Requests are closed; results are open. The atlas.* profiles atlas.describe serves use exactly these schemas. Every member listed without `?` in §9.3.2 is required.",
  "$defs": {
    "whoami_request": {
      "type": "object",
      "description": "atlas.whoami:fetch.",
      "additionalProperties": false,
      "properties": {}
    },
    "whoami_result": {
      "type": "object",
      "required": [
        "principal",
        "name",
        "kind",
        "roles",
        "environment",
        "available_domains",
        "house_rules"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "description": "The caller's Entra object id.",
          "x-atlas-logical": "Principal"
        },
        "name": {
          "type": "string",
          "description": "The caller's name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "workload",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "person"
            },
            {
              "value": "workload"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ],
          "description": "Who the caller is."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The roles the caller holds."
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z](-?[a-z0-9])*$",
          "description": "The environment."
        },
        "available_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z](-?[a-z0-9])*$"
          },
          "description": "The domains with something available to the caller."
        },
        "house_rules": {
          "$ref": "https://atlas.jhg.com/protocol/1.0/catalog-page.schema.json#/$defs/house_rules"
        }
      }
    },
    "catalog_request": {
      "type": "object",
      "description": "atlas.catalog:fetch; answered by catalog-page.schema.json.",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z](-?[a-z0-9])*$",
          "description": "Only this domain."
        },
        "family": {
          "type": "string",
          "enum": [
            "data",
            "resource",
            "action",
            "event"
          ],
          "description": "Only this family."
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "external",
            "irreversible"
          ],
          "description": "Only capabilities with an interaction of this effect."
        },
        "previews": {
          "type": "boolean",
          "default": false,
          "description": "Include preview capabilities."
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "x-atlas-unit": "count",
          "description": "Items per page, 1 to 500."
        }
      }
    },
    "search_request": {
      "type": "object",
      "description": "atlas.search:fetch; answered by catalog-page.schema.json, ranked. page_size as atlas.catalog's (Q-BI-1).",
      "additionalProperties": false,
      "required": [
        "words"
      ],
      "properties": {
        "words": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What to look for."
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "x-atlas-unit": "count",
          "description": "Items per page, 1 to 500."
        }
      }
    },
    "describe_request": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "id"
          ],
          "properties": {
            "by": {
              "type": "string",
              "const": "id",
              "description": "How the capability is named."
            },
            "id": {
              "type": "string",
              "description": "A capability-id or pinned-id.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "capability-id"
                },
                {
                  "type": "string",
                  "format": "pinned-id"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "exact"
          ],
          "properties": {
            "by": {
              "type": "string",
              "const": "exact",
              "description": "How the capability is named."
            },
            "exact": {
              "type": "string",
              "format": "exact-id",
              "description": "An exact-id."
            }
          }
        }
      ],
      "description": "atlas.describe:fetch; answered by describe.schema.json."
    },
    "guide_request": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "id"
          ],
          "properties": {
            "by": {
              "type": "string",
              "const": "id",
              "description": "How the capability is named."
            },
            "id": {
              "type": "string",
              "description": "A capability-id or pinned-id.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "capability-id"
                },
                {
                  "type": "string",
                  "format": "pinned-id"
                }
              ]
            },
            "client": {
              "type": "string",
              "enum": [
                "cli",
                "python",
                "node",
                "go",
                "mcp"
              ],
              "description": "Whose syntax the examples are written in."
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 200,
              "maximum": 20000,
              "default": 4000,
              "x-atlas-unit": "count",
              "description": "The guide's budget."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "exact"
          ],
          "properties": {
            "by": {
              "type": "string",
              "const": "exact",
              "description": "How the capability is named."
            },
            "exact": {
              "type": "string",
              "format": "exact-id",
              "description": "An exact-id."
            },
            "client": {
              "type": "string",
              "enum": [
                "cli",
                "python",
                "node",
                "go",
                "mcp"
              ],
              "description": "Whose syntax the examples are written in."
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 200,
              "maximum": 20000,
              "default": 4000,
              "x-atlas-unit": "count",
              "description": "The guide's budget."
            }
          }
        }
      ],
      "description": "atlas.guide:fetch."
    },
    "guide_result": {
      "type": "object",
      "required": [
        "exact",
        "client",
        "markdown",
        "tokens",
        "truncated",
        "revisions"
      ],
      "properties": {
        "exact": {
          "type": "string",
          "format": "exact-id"
        },
        "client": {
          "type": "string",
          "enum": [
            "cli",
            "python",
            "node",
            "go",
            "mcp",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "cli"
            },
            {
              "value": "python"
            },
            {
              "value": "node"
            },
            {
              "value": "go"
            },
            {
              "value": "mcp"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ]
        },
        "markdown": {
          "type": "string",
          "description": "The guide (§2.6), returned unchanged."
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count"
        },
        "truncated": {
          "type": "boolean",
          "description": "Whether sections were shortened to fit max_tokens."
        },
        "revisions": {
          "type": "object",
          "description": "The revisions it was written from: the profile's prose, governance and context (Q-BI-2)."
        }
      }
    },
    "access_request": {
      "type": "object",
      "description": "atlas.access:fetch; answered by a page of access_entry.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "format": "capability-id"
            },
            {
              "type": "string",
              "format": "pinned-id"
            }
          ],
          "description": "Only this capability."
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z](-?[a-z0-9])*$",
          "description": "Only this domain."
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        }
      }
    },
    "access_entry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "reason",
        "next"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "format": "capability-id"
            },
            {
              "type": "string",
              "format": "pinned-id"
            }
          ],
          "description": "The capability."
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "not_granted",
            "denied",
            "not_in_environment",
            "limited",
            "deprecated",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "available"
            },
            {
              "value": "partial"
            },
            {
              "value": "not_granted"
            },
            {
              "value": "denied"
            },
            {
              "value": "not_in_environment"
            },
            {
              "value": "limited"
            },
            {
              "value": "deprecated"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ],
          "description": "The caller's status (§2.6)."
        },
        "reason": {
          "type": "string",
          "description": "Why."
        },
        "next": {
          "type": "string",
          "description": "How to get it."
        },
        "held_by": {
          "type": "string",
          "description": "How the caller holds it."
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "https://atlas.jhg.com/protocol/1.0/governance.schema.json#/$defs/limit"
          }
        },
        "interactions": {
          "type": "object",
          "description": "Per interaction: how it is held, its limits."
        }
      }
    },
    "usage_request": {
      "type": "object",
      "description": "atlas.usage:fetch; answered by a page of usage_entry.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "format": "capability-id"
            },
            {
              "type": "string",
              "format": "pinned-id"
            }
          ],
          "description": "Only this capability."
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "description": "Only this period."
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        }
      }
    },
    "usage_entry": {
      "type": "object",
      "required": [
        "id",
        "interaction",
        "kind",
        "used",
        "limit",
        "remaining",
        "period"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "format": "capability-id"
            },
            {
              "type": "string",
              "format": "pinned-id"
            }
          ],
          "description": "The capability."
        },
        "interaction": {
          "type": "string",
          "pattern": "^[a-z](-?[a-z0-9])*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "rate",
            "concurrency",
            "output",
            "budget",
            "confirmation",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "rate"
            },
            {
              "value": "concurrency"
            },
            {
              "value": "output"
            },
            {
              "value": "budget"
            },
            {
              "value": "confirmation"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ]
        },
        "used": {
          "type": "number",
          "description": "What was used.",
          "x-atlas-unit": "count"
        },
        "limit": {
          "type": "number",
          "description": "The limit.",
          "x-atlas-unit": "count"
        },
        "remaining": {
          "type": "number",
          "description": "What is left.",
          "x-atlas-unit": "count"
        },
        "period": {
          "type": "string"
        },
        "pool": {
          "type": "string",
          "description": "The pool it draws on."
        }
      }
    },
    "setup_request": {
      "type": "object",
      "description": "atlas.setup:fetch.",
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "description": "The harness to set up."
        }
      }
    },
    "setup_result": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "done",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              },
              "command": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "clients_request": {
      "type": "object",
      "description": "atlas.clients:fetch; answered by a page of client_entry.",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        }
      }
    },
    "client_entry": {
      "type": "object",
      "required": [
        "name",
        "language",
        "built_for",
        "roles",
        "levels",
        "extras",
        "version",
        "install"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "built_for": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "core",
              "streaming",
              "columnar",
              "bulk",
              "events",
              "handoff",
              "broker",
              "UNKNOWN"
            ],
            "x-atlas-enum": [
              {
                "value": "core"
              },
              {
                "value": "streaming"
              },
              {
                "value": "columnar"
              },
              {
                "value": "bulk"
              },
              {
                "value": "events"
              },
              {
                "value": "handoff"
              },
              {
                "value": "broker"
              },
              {
                "value": "UNKNOWN",
                "description": "A value this reader does not know (§9.5.5)."
              }
            ]
          }
        },
        "extras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "install": {
          "type": "string"
        }
      }
    },
    "compare_request": {
      "type": "object",
      "description": "atlas.compare:fetch; answered by a table of the two results joined on their keys.",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "request"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "capability-id",
          "description": "The data capability."
        },
        "from": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$",
          "description": "One version (`v1`)."
        },
        "to": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$",
          "description": "The other (`v2`)."
        },
        "request": {
          "type": "object",
          "description": "A request both versions take; free-form here (Q-PROF-9)."
        }
      }
    },
    "operation_get_request": {
      "type": "object",
      "description": "atlas.operation:get, :cancel and :watch (Q-BI-3).",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^operations/[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "operation_list_request": {
      "type": "object",
      "description": "atlas.operation:list; answered by a page of operations.",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "description": "Only operations in this state."
        }
      }
    },
    "catalog_changed_payload": {
      "type": "object",
      "description": "atlas.catalog.changed: each event's data.",
      "required": [
        "catalog_etag"
      ],
      "properties": {
        "catalog_etag": {
          "type": "string",
          "pattern": "^(W/)?\"[!#-~]*\"$",
          "description": "The catalogue's ETag after the change."
        }
      }
    },
    "settings_get_request": {
      "type": "object",
      "description": "atlas.settings:get.",
      "additionalProperties": false,
      "properties": {}
    },
    "settings_update_request": {
      "type": "object",
      "description": "atlas.settings:update, sent with If-Match.",
      "additionalProperties": false,
      "required": [
        "fields",
        "settings"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The field mask: the settings members to change."
        },
        "settings": {
          "type": "object",
          "description": "The new values; free-form here (Q-PROF-9)."
        }
      }
    },
    "directory_request": {
      "type": "object",
      "description": "atlas.directory:fetch; answered by a page of directory_entry (Q-BI-4).",
      "additionalProperties": false,
      "required": [
        "words"
      ],
      "properties": {
        "words": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Whom to look for."
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "group"
          ],
          "description": "Only people or only groups."
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "The opaque cursor of the page to read; absent for the first page."
        }
      }
    },
    "directory_entry": {
      "type": "object",
      "required": [
        "principal",
        "name",
        "kind"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "description": "The Entra object id.",
          "x-atlas-logical": "Principal"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "group",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "person"
            },
            {
              "value": "group"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ]
        }
      }
    },
    "audit_request": {
      "type": "object",
      "description": "atlas.audit:fetch (Gateway.Admin).",
      "additionalProperties": false,
      "required": [
        "day"
      ],
      "properties": {
        "day": {
          "type": "string",
          "format": "date",
          "description": "The day to read."
        },
        "before": {
          "type": "string",
          "minLength": 1,
          "description": "Read records before this one."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 200,
          "x-atlas-unit": "count",
          "description": "Items per page, 1 to 1000."
        }
      }
    },
    "audit_record": {
      "type": "object",
      "description": "One call's record (§6.2.8).",
      "required": [
        "request_id",
        "time",
        "address",
        "caller",
        "decision",
        "outcome"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "address": {
          "type": "string",
          "format": "address"
        },
        "caller": {
          "type": "object",
          "properties": {
            "principal": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "workload",
                "UNKNOWN"
              ],
              "x-atlas-enum": [
                {
                  "value": "person"
                },
                {
                  "value": "workload"
                },
                {
                  "value": "UNKNOWN",
                  "description": "A value this reader does not know (§9.5.5)."
                }
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "protocol": {
              "type": "string",
              "pattern": "^atlas/[0-9]+\\.[0-9]+$"
            }
          }
        },
        "edge": {
          "type": "string"
        },
        "hops": {
