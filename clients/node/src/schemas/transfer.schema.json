{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jhg.com/protocol/1.0/transfer.schema.json",
  "title": "Transfer",
  "description": "`transfer` delivery and `:export` (§2.1.D, §9.6.5): the result, when succeeded, of the operation a transfer answers with. A download lists its files: each fetched by its parts' links with GET and checked by `sha256`, or, under 1 MiB, inline (the fallback every client can read, Q-DOC-14). An upload lists the parts to PUT (at most 8 MiB each, in any order), then the client calls `commit` with $defs/commit_request and the same Idempotency-Key. Links are used only until `expires`.",
  "type": "object",
  "required": [
    "kind",
    "operation",
    "expires"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "download",
        "upload",
        "UNKNOWN"
      ],
      "x-atlas-enum": [
        {
          "value": "download"
        },
        {
          "value": "upload"
        },
        {
          "value": "UNKNOWN",
          "description": "A value this reader does not know (§9.5.5)."
        }
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "azure-blob",
        "http-range",
        "graph-upload-session",
        "UNKNOWN"
      ],
      "x-atlas-enum": [
        {
          "value": "azure-blob"
        },
        {
          "value": "http-range"
        },
        {
          "value": "graph-upload-session"
        },
        {
          "value": "UNKNOWN",
          "description": "A value this reader does not know (§9.5.5)."
        }
      ]
    },
    "operation": {
      "type": "string",
      "pattern": "^operations/[a-z0-9][a-z0-9-]*$",
      "description": "The operation the transfer belongs to; asked again for fresh links."
    },
    "expires": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "description": "A download's files: one for content, several for an export."
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      },
      "description": "An upload's parts."
    },
    "commit": {
      "$ref": "https://atlas.jhg.com/protocol/1.0/binding.schema.json"
    },
    "chunking": {
      "type": "object",
      "properties": {
        "part_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608,
          "x-atlas-unit": "count"
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "x-atlas-unit": "count"
        },
        "checksum": {
          "type": "string",
          "enum": [
            "sha256",
            "UNKNOWN"
          ],
          "x-atlas-enum": [
            {
              "value": "sha256"
            },
            {
              "value": "UNKNOWN",
              "description": "A value this reader does not know (§9.5.5)."
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "download"
          }
        }
      },
      "then": {
        "required": [
          "files"
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "upload"
          }
        }
      },
      "then": {
        "required": [
          "parts",
          "commit"
        ]
      }
    }
  ],
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "url",
        "offset",
        "bytes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "A short-lived link; the link is the credential."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count",
          "description": "The part's first byte in its file."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 of the part's bytes."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "name",
        "media_type",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The file's name: the content's `name` from its metadata, else `content`."
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "x-atlas-unit": "count"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Of the whole file."
        },
        "metadata": {
          "type": "object",
          "description": "The content's metadata record, unchanged."
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "offset",
              "bytes"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "A short-lived link; the link is the credential."
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "x-atlas-unit": "count",
                "description": "The part's first byte in its file."
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "x-atlas-unit": "count"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Lowercase hexadecimal SHA-256 of the part's bytes."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "inline": {
          "type": "string",
          "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "description": "The file's bytes, base64, when under 1 MiB."
        }
      }
    },
    "commit_request": {
      "type": "object",
      "description": "The body of the transfer's `commit` call (§9.6.5): a request, so closed.",
      "additionalProperties": false,
      "required": [
        "operation",
        "parts"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^operations/[a-z0-9][a-z0-9-]*$"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
