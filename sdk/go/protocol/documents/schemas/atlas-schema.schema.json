          "type": "string"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/schema"
          }
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/schema"
            }
          ]
        },
        "items": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/schema"
            }
          ]
        },
        "prefixItems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/schema"
          }
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/schema"
          }
        },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/schema"
              },
              {
                "type": "object",
                "required": [
                  "properties",
                  "required"
                ]
              }
            ]
          }
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "null",
                "boolean",
                "object",
                "array",
                "number",
                "integer",
                "string"
              ]
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "enum": [
                    "boolean",
                    "object",
                    "array",
                    "number",
                    "integer",
                    "string"
                  ]
                },
                {
                  "const": "null"
                }
              ],
              "items": false,
              "minItems": 2
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "const": {},
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "multipleOf": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string",
          "pattern": "^\\^.*\\$$"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "minProperties": {
          "type": "integer",
          "minimum": 0
        },
        "maxProperties": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "deprecated": {
          "type": "boolean"
        },
        "examples": {
          "type": "array"
        },
        "readOnly": {
          "type": "boolean"
        },
        "writeOnly": {
          "type": "boolean"
        },
        "format": {
          "enum": [
            "date",
            "date-time",
            "duration",
            "decimal",
            "int64",
            "uri",
            "uuid",
            "capability-id",
            "pinned-id",
            "exact-id",
            "address"
          ]
        },
        "x-atlas-logical": {
          "anyOf": [
            {
              "enum": [
                "Bp",
                "Country",
                "Currency",
                "Cusip",
                "Figi",
                "Fraction",
                "IndexCode",
                "Isin",
                "Lei",
                "Money",
                "Path",
                "Percent",
                "PortfolioCode",
                "Principal",
                "Sedol",
                "Tenor",
                "Uri",
                "Years"
              ]
            },
            {
              "type": "string",
              "pattern": "^Decimal\\(([1-9]|[12][0-9]|3[0-8]),([0-9]|[12][0-9]|3[0-8])\\)$"
            }
          ]
        },
        "x-atlas-key": {
          "const": true
        },
        "x-atlas-aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "x-atlas-reference": {
          "type": "string",
          "format": "pinned-id"
        },
        "x-atlas-deprecated": {
          "$ref": "#/$defs/deprecation"
        },
        "x-atlas-unit": {
          "enum": [
            "bp",
            "percent",
            "fraction",
            "years",
            "days",
            "seconds",
            "count",
            "currency_unit"
          ]
        },
        "x-atlas-enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enum_entry"
          }
        }
      }
    },
    "deprecation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "since",
            "sunset",
            "replaced_by"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "since": {
              "type": "string",
              "format": "date"
            },
            "sunset": {
              "type": "string",
              "format": "date"
            },
            "replaced_by": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "enum_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
