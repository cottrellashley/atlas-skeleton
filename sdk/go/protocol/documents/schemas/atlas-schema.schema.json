{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jhg.com/protocol/1.0/atlas-schema.schema.json",
  "title": "The Atlas Schema profile",
  "description": "The meta-schema for every schema inside a profile (§9.2): JSON Schema 2020-12 restricted to the keywords and formats of §9.2.1–§9.2.2, with the Atlas vocabulary of §9.2.3. Beyond what a meta-schema can express, a schema in the profile also: has `^ R $` patterns whose R is an I-Regexp (§9.2.4); nests no deeper than 32 levels and is at most 1 MiB as UTF-8 (canonical form); closes every object of a request schema and leaves every other open; has UNKNOWN in every string enum outside requests and never in one; uses $ref only to an existing #/$defs/<name>, with no recursion; uses oneOf only with a const discriminator required in every branch; puts x-atlas-key only on required, non-null result properties (Isin, Cusip, Sedol, Figi and Lei may be missing). references/vectors/schemas.json tests every rule; QUESTIONS.md records the readings (Q-PROF-n).",
  "type": "object",
  "required": [
    "$schema",
    "$vocabulary"
  ],
  "additionalProperties": false,
  "properties": {
    "$ref": {
      "type": "string",
      "pattern": "^#/\\$defs/[^/]+$"
    },
    "$comment": {
      "type": "string"
    },
    "properties": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/schema"
      }
    },
    "additionalProperties": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/schema"
        }
      ]
    },
    "items": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/schema"
        }
      ]
    },
    "prefixItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/schema"
      }
    },
    "anyOf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/schema"
      }
    },
    "oneOf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/schema"
          },
          {
            "type": "object",
            "required": [
              "properties",
              "required"
            ]
          }
        ]
      }
    },
    "type": {
      "anyOf": [
        {
          "enum": [
            "null",
            "boolean",
            "object",
            "array",
            "number",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "boolean",
                "object",
                "array",
                "number",
                "integer",
                "string"
              ]
            },
            {
              "const": "null"
            }
          ],
          "items": false,
          "minItems": 2
        }
      ]
    },
    "enum": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    },
    "const": {},
    "required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "minimum": {
      "type": "number"
    },
    "maximum": {
      "type": "number"
    },
    "exclusiveMinimum": {
      "type": "number"
    },
    "exclusiveMaximum": {
      "type": "number"
    },
    "multipleOf": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "minLength": {
      "type": "integer",
      "minimum": 0
    },
    "maxLength": {
      "type": "integer",
      "minimum": 0
    },
    "pattern": {
      "type": "string",
      "pattern": "^\\^.*\\$$"
    },
    "minItems": {
      "type": "integer",
      "minimum": 0
    },
    "maxItems": {
      "type": "integer",
      "minimum": 0
    },
    "uniqueItems": {
      "type": "boolean"
    },
    "minProperties": {
      "type": "integer",
      "minimum": 0
    },
    "maxProperties": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "default": {},
    "deprecated": {
      "type": "boolean"
    },
    "examples": {
      "type": "array"
    },
    "readOnly": {
      "type": "boolean"
    },
    "writeOnly": {
      "type": "boolean"
    },
    "format": {
      "enum": [
        "date",
        "date-time",
        "duration",
        "decimal",
        "int64",
        "uri",
        "uuid",
        "capability-id",
        "pinned-id",
        "exact-id",
        "address"
      ]
    },
    "x-atlas-logical": {
      "anyOf": [
        {
          "enum": [
            "Bp",
            "Country",
            "Currency",
            "Cusip",
            "Figi",
            "Fraction",
            "IndexCode",
            "Isin",
            "Lei",
            "Money",
            "Path",
            "Percent",
            "PortfolioCode",
            "Principal",
            "Sedol",
            "Tenor",
            "Uri",
            "Years"
          ]
        },
        {
          "type": "string",
          "pattern": "^Decimal\\(([1-9]|[12][0-9]|3[0-8]),([0-9]|[12][0-9]|3[0-8])\\)$"
        }
      ]
    },
    "x-atlas-key": {
      "const": true
    },
    "x-atlas-aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "x-atlas-reference": {
      "type": "string",
      "format": "pinned-id"
    },
    "x-atlas-deprecated": {
      "$ref": "#/$defs/deprecation"
    },
    "x-atlas-unit": {
      "enum": [
        "bp",
        "percent",
        "fraction",
        "years",
        "days",
        "seconds",
        "count",
        "currency_unit"
      ]
    },
    "x-atlas-enum": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/enum_entry"
      }
    },
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$vocabulary": {
      "const": {
        "https://json-schema.org/draft/2020-12/vocab/core": true,
        "https://json-schema.org/draft/2020-12/vocab/applicator": true,
        "https://json-schema.org/draft/2020-12/vocab/validation": true,
        "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
        "https://json-schema.org/draft/2020-12/vocab/format-assertion": true,
        "https://atlas.jhg.com/vocab/2026-10": false
      }
    },
    "$id": {
      "type": "string",
      "format": "uri"
    },
    "$defs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/schema"
      }
    }
  },
  "$defs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/\\$defs/[^/]+$"
        },
