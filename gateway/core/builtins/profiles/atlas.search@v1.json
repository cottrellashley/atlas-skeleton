{
 "identity": {
  "id": "atlas.search",
  "version": 1,
  "title": "atlas.search",
  "summary": "The built-in atlas.search (§9.3.2).",
  "domain": "atlas",
  "owner": "Atlas"
 },
 "properties": {
  "family": "data",
  "stability": "official",
  "lifecycle": "stable",
  "visibility": "listed",
  "traits": []
 },
 "interactions": {
  "fetch": {
   "effect": "read",
   "result": "collection",
   "delivery": "single",
   "execution": [
    "gateway"
   ],
   "takes": "search_request",
   "returns": "catalog_page",
   "deadline": {
    "default": "PT30S",
    "max": "PT2M"
   },
   "bindings": [
    {
     "protocol": "https",
     "server": "gateway",
     "method": "POST",
     "address": "/v1/atlas/atlas.search:fetch",
     "encodings": [
      "json"
     ],
     "auth": "bearer"
    }
   ]
  }
 },
 "schemas": {
  "search_request": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-assertion": true,
    "https://atlas.jhg.com/vocab/2026-10": false
   },
   "$ref": "https://atlas.jhg.com/protocol/1.0/builtins.schema.json#/$defs/search_request"
  },
  "catalog_page": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-assertion": true,
    "https://atlas.jhg.com/vocab/2026-10": false
   },
   "$ref": "https://atlas.jhg.com/protocol/1.0/catalog-page.schema.json"
  }
 },
 "errors": [],
 "meaning": {
  "grain": "fixed by atlas/1.0",
  "source": "the gateway"
 },
 "usage": {
  "when": "You have the person's words and need the capabilities you can use that answer them, ranked, each with why it matched.",
  "when_not": "You know the capability: atlas.guide@v1 says how to use it. You want everything in a domain: atlas.catalog@v1.",
  "examples": [
   {
    "title": "Capabilities for a question",
    "interaction": "fetch",
    "request": {
     "words": "credit curves"
    }
   }
  ],
  "related": [
   "atlas.catalog@v1",
   "atlas.guide@v1"
  ]
 }
}
