{
 "identity": {
  "id": "atlas.whoami",
  "version": 1,
  "title": "atlas.whoami",
  "summary": "The built-in atlas.whoami (§9.3.2).",
  "domain": "atlas",
  "owner": "Atlas"
 },
 "properties": {
  "family": "data",
  "stability": "official",
  "lifecycle": "stable",
  "visibility": "listed",
  "traits": []
 },
 "interactions": {
  "fetch": {
   "effect": "read",
   "result": "record",
   "delivery": "single",
   "execution": [
    "gateway"
   ],
   "takes": "whoami_request",
   "returns": "whoami_result",
   "deadline": {
    "default": "PT30S",
    "max": "PT2M"
   },
   "bindings": [
    {
     "protocol": "https",
     "server": "gateway",
     "method": "POST",
     "address": "/v1/atlas/atlas.whoami:fetch",
     "encodings": [
      "json"
     ],
     "auth": "bearer"
    }
   ]
  }
 },
 "schemas": {
  "whoami_request": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-assertion": true,
    "https://atlas.jhg.com/vocab/2026-10": false
   },
   "$ref": "https://atlas.jhg.com/protocol/1.0/builtins.schema.json#/$defs/whoami_request"
  },
  "whoami_result": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-assertion": true,
    "https://atlas.jhg.com/vocab/2026-10": false
   },
   "type": "object",
   "required": [
    "principal",
    "name",
    "kind",
    "roles",
    "environment",
    "available_domains",
    "house_rules"
   ],
   "properties": {
    "principal": {
     "type": "string",
     "description": "The caller's Entra object id.",
     "x-atlas-logical": "Principal"
    },
    "name": {
     "type": "string",
     "description": "The caller's name."
    },
    "kind": {
     "type": "string",
     "enum": [
      "person",
      "workload",
      "UNKNOWN"
     ],
     "x-atlas-enum": [
      {
       "value": "person"
      },
      {
       "value": "workload"
      },
      {
       "value": "UNKNOWN",
       "description": "A value this reader does not know (§9.5.5)."
      }
     ],
     "description": "Who the caller is."
    },
    "roles": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "The roles the caller holds."
    },
    "environment": {
     "type": "string",
     "pattern": "^[a-z](-?[a-z0-9])*$",
     "description": "The environment."
    },
    "available_domains": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z](-?[a-z0-9])*$"
     },
     "description": "The domains with something available to the caller."
    },
    "house_rules": {
     "$ref": "https://atlas.jhg.com/protocol/1.0/catalog-page.schema.json#/$defs/house_rules"
    },
    "scope": {
     "type": "object",
     "description": "The data you may read, by access dimension: every dimension the deployment defines, each with the codes you may read sorted, [\"*\"] when you may read every one, and [] when none. A dimension is never left out, so none reads as unrestricted by its absence.",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "A code of the dimension, or * for every one."
      },
      "description": "The codes of one dimension you may read."
     }
    }
   },
   "description": "Who you are, your roles, the environment, the domains with something available to you, the house rules that reach you, and the data you may read. It is the protocol's whoami_result (builtins.schema.json) with scope added: the access-dimension amendment (ASSUMPTIONS.md A-200)."
  }
 },
 "errors": [],
 "meaning": {
  "grain": "fixed by atlas/1.0",
  "source": "the gateway"
 },
 "usage": {
  "when": "You start a session, or need to know who you are to the gateway: your identity, roles and environment, the data you may read, the domains with something for you, and the house rules.",
  "when_not": "You want the capabilities themselves: atlas.catalog@v1 lists them, and atlas.search@v1 ranks them against the person's words.",
  "examples": [
   {
    "title": "Who you are here",
    "interaction": "fetch",
    "request": {}
   }
  ],
  "related": [
   "atlas.catalog@v1",
   "atlas.search@v1",
   "atlas.access@v1"
  ]
 }
}
